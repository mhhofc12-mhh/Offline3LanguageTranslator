<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- App Logo -->
        <ImageView
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/translator_logo"
            android:scaleType="centerInside"
            android:contentDescription="App Logo" />

        <!-- App Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:gravity="center" />

        <!-- Developer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/developed_by"
            android:textSize="13sp"
            android:textColor="#667085"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="● Offline translation"
            android:textSize="13sp"
            android:textColor="#16794C"
            android:gravity="center"
            android:background="#E8F7EF"
            android:padding="10dp"
            android:layout_marginBottom="18dp" />

        <!-- Bangla -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🇧🇩  বাংলা"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/banglaInput"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:hint="এখানে বাংলা লিখুন..."
            android:gravity="top|start"
            android:padding="15dp"
            android:background="@drawable/box_bg"
            android:inputType="textMultiLine"
            android:textSize="17sp"
            android:textColor="#111827"
            android:textColorHint="#98A2B3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:layout_marginTop="5dp">

            <Button
                android:id="@+id/bnVoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎤"
                android:minWidth="48dp" />

            <Button
                android:id="@+id/bnSpeak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊"
                android:minWidth="48dp" />

            <Button
                android:id="@+id/bnCopy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋"
                android:minWidth="48dp" />
        </LinearLayout>

        <!-- Swap -->
        <Button
            android:id="@+id/swapButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⇅  SWAP LANGUAGES"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp" />

        <!-- English -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🇬🇧  English"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/englishInput"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:hint="Type English here..."
            android:gravity="top|start"
            android:padding="15dp"
            android:background="@drawable/box_bg"
            android:inputType="textMultiLine"
            android:textSize="17sp"
            android:textColor="#111827"
            android:textColorHint="#98A2B3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:layout_marginTop="5dp">

            <Button
                android:id="@+id/enVoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎤"
                android:minWidth="48dp" />

            <Button
                android:id="@+id/enSpeak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊"
                android:minWidth="48dp" />

            <Button
                android:id="@+id/enCopy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋"
                android:minWidth="48dp" />
        </LinearLayout>

        <!-- Arabic -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🇸🇦  العربية"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:gravity="end"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/arabicInput"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:hint="اكتب هنا..."
            android:gravity="top|start"
            android:padding="15dp"
            android:background="@drawable/box_bg"
            android:inputType="textMultiLine"
            android:textSize="17sp"
            android:textColor="#111827"
            android:textColorHint="#98A2B3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:layout_marginTop="5dp">

            <Button
                android:id="@+id/arVoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎤"
                android:minWidth="48dp" />

            <Button
                android:id="@+id/arSpeak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊"
                android:minWidth="48dp" />

            <Button
                android:id="@+id/arCopy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋"
                android:minWidth="48dp" />
        </LinearLayout>

        <!-- Clear -->
        <Button
            android:id="@+id/clearButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧹  CLEAR ALL"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <!-- Bottom Credit -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Developed by Hafizur Rohman Mehedi"
            android:textSize="12sp"
            android:textColor="#98A2B3"
            android:gravity="center"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="12dp" />

    </LinearLayout>

</ScrollView>
```
